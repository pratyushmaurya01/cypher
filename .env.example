# Cypher Neo4j AuraDB Configuration Template
# Copy this file to .env and fill in your actual credentials.
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=<your-strong-password>
NEO4J_DATABASE=neo4j

# PostgreSQL Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cypher

# JWT Authentication
JWT_SECRET_KEY=generate-a-strong-random-secret-key-for-production

# Stage 5 — Gemini RAG (Retrieval-Augmented Generation)
# Get your free API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
CHROMA_PERSIST_DIR=./chroma_db
